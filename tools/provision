#!/usr/bin/env bash

# Use this script to provision dependencies for your Zulip installation.
# This script is idempotent, so it can be restarted at any time, and it
# will usually run fairly quickly when your dependencies are up to date.

set -e
if [ "$EUID" -eq 0 ]; then
    echo "Error: The provision script must not be run as root" >&2
    exit 1
fi

if [ -e "$(dirname "${BASH_SOURCE[0]}")/../.vagrant" ] && [ ! -e /home/vagrant ]; then
    echo 'Error: provision should be run inside the Vagrant environment.' >&2
    # shellcheck disable=SC2016
    echo 'Try `vagrant up --provision`.' >&2
    exit 1
fi

# Re-exec under devenv shell when this checkout has a devenv setup but
# we aren't in it; from inside the shell the rest of the script runs
# against the Nix-provided Python/Node/uv/pnpm and the per-checkout
# postgres / rabbitmq / etc.  Done before the host Python version check
# below so the host can run a Python older than 3.10 as long as devenv
# is set up.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null && pwd)
zulip_root=$(cd -- "$script_dir/.." >/dev/null && pwd)
if [ -f "$zulip_root/devenv.local.nix" ] && [ -z "${DEVENV_ROOT:-}" ]; then
    if ! command -v devenv >/dev/null; then
        echo >&2 "tools/provision: devenv.local.nix is present but the \`devenv\` binary"
        echo >&2 "isn't on PATH; install devenv (https://devenv.sh) or remove devenv.local.nix"
        echo >&2 "to opt out."
        exit 1
    fi
    echo "tools/provision: re-entering \`devenv shell\` for per-checkout services..."
    exec devenv shell -- "$0" "$@"
fi

os="$(. /etc/os-release && echo "$ID $VERSION_ID")"
case "$os" in
    'ubuntu 14.04' | 'ubuntu 16.04' | 'ubuntu 18.04' | 'debian 10')
        echo "Error: $os is no longer a supported platform for Zulip." >&2
        if [ -e /home/vagrant ]; then
            # shellcheck disable=SC2016
            echo 'To upgrade, run `vagrant destroy`, and then recreate the Vagrant guest.' >&2
            echo 'See: https://zulip.readthedocs.io/en/latest/development/setup-recommended.html' >&2
        fi
        exit 1
        ;;
esac

python_version="$(python3 --version)"
case "$python_version" in
    Python\ 3.[0-9].*)
        echo 'Error: Zulip requires an OS with Python 3.10 or later.' >&2
        exit 1
        ;;
esac

FAIL='\033[91m'
WARNING='\033[93m'
ENDC='\033[0m'

# Make the script independent of the location from where it is executed
PARENT_PATH=$(
    cd "$(dirname "${BASH_SOURCE[0]}")/.."
    pwd -P
)
cd "$PARENT_PATH"
mkdir -p var/log
LOG_PATH="var/log/provision.log"

echo "PROVISIONING STARTING." >>$LOG_PATH

# PYTHONUNBUFFERED is important to ensure that tracebacks don't get
# lost far above where they should be in the output.
export PYTHONUNBUFFERED=1
if [ -n "${DEVENV_ROOT:-}" ]; then
    # Under devenv the Nix toolchain replaces tools/lib/provision.py's
    # apt/yum installs, install-node, install-uv, install-{shellcheck,
    # shfmt,tusd}, the tsearch-stopwords copy, and the system-service
    # starts.  Run the venv + node_modules refresh directly and hand off
    # to provision_inner.py for the per-checkout work (assets,
    # migrations, configure-rabbitmq, etc.).
    #
    # A stray VIRTUAL_ENV inherited from the parent shell (e.g. when
    # the user's interactive shell auto-activated the main checkout's
    # .venv) makes uv warn that it conflicts with the devenv-provided
    # UV_PROJECT_ENVIRONMENT; the latter wins regardless, so clear
    # VIRTUAL_ENV up front for a clean log.
    unset VIRTUAL_ENV
    (
        set -e
        echo "==> uv sync"
        uv sync --frozen
        echo "==> pnpm install"
        # confirm-modules-purge=false: pnpm 9+ asks for interactive
        # confirmation before removing an out-of-date node_modules
        # directory; piping our stdout through tee removes the
        # controlling tty from pnpm's view, so it would otherwise
        # abort with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
        pnpm install --frozen-lockfile --prefer-offline \
            --config.confirm-modules-purge=false
        echo "==> tools/lib/provision_inner.py"
        exec uv run --no-sync tools/lib/provision_inner.py "$@"
    ) 2>&1 | tee -a "$LOG_PATH"
    failed=${PIPESTATUS[0]}
else
    tools/lib/provision.py "$@" 2>&1 | tee -a "$LOG_PATH"
    failed=${PIPESTATUS[0]}
fi

if [ "$failed" -ne 0 ]; then
    echo -e "$FAIL"
    echo "Provisioning failed (exit code $failed)!"
    echo
    echo "* Look at the traceback(s) above to find more about the errors."
    echo "* Resolve the errors or get help on chat."
    echo "* If you can fix this yourself, you can re-run tools/provision at any time."
    echo "* Logs are here: zulip/var/log/provision.log"
    echo -e "$ENDC"
    exit "$failed"
elif [ -z "${DEVENV_ROOT:-}" ] && [ "$VIRTUAL_ENV" != "$PARENT_PATH/.venv" ] && [ -z "${SKIP_VENV_SHELL_WARNING}" ]; then
    echo -e "$WARNING"
    echo "WARNING: This shell does not have the Zulip Python 3 virtualenv activated."
    echo "Zulip commands will fail until you activate the virtualenv."
    echo
    echo "To update the shell, run:"
    echo "    source $PARENT_PATH/.venv/bin/activate"
    # shellcheck disable=SC2016
    echo 'or just close this shell and start a new one (with Vagrant, `vagrant ssh`).'
    echo -en "$ENDC"
fi
exit 0
