#!/usr/bin/env bash
set -e

# Re-exec under devenv shell when this checkout has a devenv setup but
# we aren't in it.  Mirrors tools/lib/devenv_supervisor.py for a bash
# entry point: invoking rebuild-test-database directly (vs. as a
# subprocess of tools/test-backend, which inherits the env) should
# still pick up the per-checkout PGHOST and friends.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null && pwd)
zulip_root=$(cd -- "$script_dir/.." >/dev/null && pwd)
if [ -f "$zulip_root/devenv.local.nix" ] && [ -z "${DEVENV_ROOT:-}" ]; then
    if ! command -v devenv >/dev/null; then
        echo >&2 "rebuild-test-database: devenv.local.nix is present but the \`devenv\` binary"
        echo >&2 "isn't on PATH; install devenv (https://devenv.sh) or remove devenv.local.nix"
        echo >&2 "to opt out."
        exit 1
    fi
    echo "rebuild-test-database: re-entering \`devenv shell\` for per-checkout services..."
    exec devenv shell -- "$0" "$@"
fi

set -x

export DJANGO_SETTINGS_MODULE=zproject.test_settings

# Honor a pre-set PGHOST (e.g. from devenv); otherwise default to
# localhost so libpq's .pgpass-based auth lookup matches the
# tools/provision setup.
export PGHOST="${PGHOST:-localhost}"

# STRATEGY = FILE_COPY: PostgreSQL 15+ defaults to WAL_LOG, which only
# replays WAL for catalog-tracked relations.  PGroonga maintains
# auxiliary "groonga" files (pgrn.*) outside the PostgreSQL catalog,
# so WAL_LOG silently drops them on TEMPLATE clones and the resulting
# database fails any query that hits a pgroonga index with
# "PGrnLookupWithSize: object isn't found: <Sources...>".  The
# STRATEGY keyword is PG15+; on older versions (Ubuntu 22.04 ships
# PG14, RHEL/CentOS 7 ships PG10) it's a syntax error, so $strategy
# is left empty there.  $strategy is set once after the bootstrap
# block below.
strategy=
create_zulip_test() {
    psql -v ON_ERROR_STOP=1 postgres zulip_test <<EOF
DROP DATABASE IF EXISTS zulip_test;
CREATE DATABASE zulip_test TEMPLATE zulip_test_base $strategy;
EOF
}

create_zulip_test_template() {
    psql -v ON_ERROR_STOP=1 postgres zulip_test <<EOF
DROP DATABASE IF EXISTS zulip_test_template;
CREATE DATABASE zulip_test_template TEMPLATE zulip_test $strategy;
EOF
}

# Lazily bootstrap the zulip_test role and zulip_test_base template
# database for the devenv flow.  In the system-postgres path,
# tools/provision (postgresql-init-test-db) handles this as root via
# sudo; devenv has no root, so we use the per-checkout `zulip`
# superuser that devenv.nix provisions.  Gated on DEVENV_ROOT so
# system flows are untouched -- if zulip_test is missing without
# DEVENV_ROOT set, that's a tools/provision problem and we let the
# subsequent psql call surface it.
maybe_bootstrap_test_db_for_devenv() {
    [ -n "${DEVENV_ROOT:-}" ] || return 0
    if ! psql -At -U zulip -d postgres -c \
            "SELECT 1 FROM pg_roles WHERE rolname='zulip_test'" | grep -q 1; then
        password=$("$(dirname "$0")/../scripts/get-django-setting" LOCAL_DATABASE_PASSWORD)
        psql -v ON_ERROR_STOP=1 -U zulip -d postgres <<EOF
CREATE USER zulip_test PASSWORD '$password' CREATEDB;
EOF
    fi
    if ! psql -At -U zulip -d postgres -c \
            "SELECT 1 FROM pg_database WHERE datname='zulip_test_base'" | grep -q 1; then
        psql -v ON_ERROR_STOP=1 -U zulip -d postgres <<EOF
CREATE DATABASE zulip_test_base OWNER zulip_test;
EOF
    fi
    # Run pgroonga creation outside the database-existence guard so a
    # prior partial run (zulip_test_base was created but the CREATE
    # EXTENSION step was interrupted) heals on retry.  CREATE EXTENSION
    # IF NOT EXISTS is cheap when the extension is already installed.
    psql -v ON_ERROR_STOP=1 -U zulip -d zulip_test_base <<EOF
CREATE EXTENSION IF NOT EXISTS pgroonga;
EOF
}

mkdir -p zerver/tests/fixtures

maybe_bootstrap_test_db_for_devenv

# Set the STRATEGY clause based on PostgreSQL's actual version (PG15+).
# Bootstrap must run first so zulip_test exists to connect as.
if (( $(psql -At -U zulip_test -d postgres -c "SHOW server_version_num") >= 150000 )); then
    strategy="STRATEGY = FILE_COPY"
fi

PGUSER=zulip \
    "$(dirname "$0")/../scripts/setup/terminate-psql-sessions" zulip_test zulip_test_base zulip_test_template

create_zulip_test

"$(dirname "$0")/../scripts/setup/flush-memcached"

./manage.py migrate --noinput
./manage.py get_migration_status --output="migration_status_test"

# This next line can be simplified to "-n0" once we fix our app (and tests) with 0 messages.
./manage.py populate_db --test-suite -n30 --threads=1 \
    --max-topics=3 \
    --direct-message-groups=0 --personals=0 --percent-direct-message-groups=0 --percent-personals=0

./manage.py dumpdata \
    zerver.UserProfile zerver.Stream zerver.Recipient \
    zerver.Subscription zerver.Message zerver.DirectMessageGroup zerver.Realm \
    zerver.UserMessage zerver.Client \
    zerver.DefaultStream >zerver/tests/fixtures/messages.json

# create pristine template database, for fast fixture restoration after tests are run.
create_zulip_test_template
